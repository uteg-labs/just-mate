{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/ios",
      "!**/android",
      "!**/.expo",
      "!ml",
      "!**/bun.lock",
      "!**/assets",
      "!server/drizzle/meta",
      "!video/Just-Mate App Prototype",
      "!**/package.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "noParameterAssign": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "noUselessElse": "error",
        "noDefaultExport": "off"
      },
      "complexity": {
        "noUselessTernary": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
