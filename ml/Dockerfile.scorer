# Match-scorer container — runs two HTTP servers in one process:
#   :8000  match_scorer     (target_emb + self_emb + soft_jacc → score)
#   :8001  interest_matcher (interests_a + interests_b → soft_jacc breakdown)
#
# Both use the same Python + numpy + onnxruntime dependency stack; only the
# Python script + ONNX checkpoints + interest vocabulary are loaded at boot.
#
# Build:  docker build -f ml/Dockerfile.scorer -t match-scorer ml/
# Run:    docker run --rm -p 8000:8000 -p 8001:8001 match-scorer
#
# Weights and vocab are pulled from a GitHub release at build time, not from
# git. The release is created by ml/scripts/release_models.sh — it tags
# `ml-models@<semver>` and uploads the six files below.
#
#   docker build --build-arg MODEL_RELEASE_TAG=ml-models@1.0.0 \
#     -f ml/Dockerfile.scorer ml/

FROM python:3.11-slim AS base

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/scripts:/app/src

WORKDIR /app

# Runtime deps pinned to the same versions DEPLOYMENT.md §2.1 was tested
# against. Mismatched ABI → silent crashes ("DLL load failed").
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir 'numpy==1.26.4' 'onnxruntime==1.19.2'

# Runtime scripts and source tree only (see .dockerignore).
COPY scripts/match_scorer_server.py scripts/interest_matcher_server.py scripts/run_servers.py scripts/
COPY src ./src

# Download weights + vocab from a GitHub release. BuildKit caches this layer,
# so re-builds without a tag change skip the download entirely.
#
# Args:
#   MODEL_RELEASE_TAG    tag like "ml-models@1.0.0"
#   GITHUB_REPO          org/repo slug — override for forks
#
# Release assets are flat; both ONNX models + their JSON model cards + the
# interest vocabulary land in /app/{checkpoints,data}. Failing to fetch is
# loud (curl -f, exit on the first miss) so partial releases don't ship a
# 500-ing container.
ARG MODEL_RELEASE_TAG=ml-models@1.0.0
ARG GITHUB_REPO=uteg-labs/just-mate
ENV MODEL_RELEASE_URL=https://github.com/${GITHUB_REPO}/releases/download/${MODEL_RELEASE_TAG}

ARG MATCH_SCORER_MODEL_FILE=model_v3_best.onnx
ARG INTEREST_MATCHER_MODEL_FILE=interest_matcher.onnx

RUN mkdir -p /app/checkpoints /app/data \
    && for f in \
        checkpoints/${MATCH_SCORER_MODEL_FILE} \
        checkpoints/${MATCH_SCORER_MODEL_FILE%.onnx}.json \
        checkpoints/${INTEREST_MATCHER_MODEL_FILE} \
        checkpoints/${INTEREST_MATCHER_MODEL_FILE%.onnx}.json \
        data/interest_embeddings.npz \
        data/interest_index.json; do \
        echo "→ fetching $f from ${MODEL_RELEASE_URL}"; \
        curl -fsSL --retry 3 --retry-delay 2 \
            -o "/app/$f" \
            "${MODEL_RELEASE_URL}/${f##*/}" || exit 1; \
    done

ENV MATCH_SCORER_MODEL=/app/checkpoints/${MATCH_SCORER_MODEL_FILE} \
    INTEREST_MATCHER_MODEL=/app/checkpoints/${INTEREST_MATCHER_MODEL_FILE} \
    INTEREST_MATCHER_DATA_DIR=/app/data \
    HOST=0.0.0.0 \
    MATCH_SCORER_PORT=8000 \
    INTEREST_MATCHER_PORT=8001 \
    LOG_LEVEL=info

EXPOSE 8000 8001

# Healthcheck on the lighter endpoint. The interest_matcher boot loads
# interest_embeddings.npz (~few MB) and is slightly slower to come up.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["python", "scripts/run_servers.py"]