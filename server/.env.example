PORT=3000
MOCK_PORT=3001
# URL of the match_scorer HTTP container. Local compose: http://scorer:8000
# Required when profiles are created or their matching inputs change.
MATCH_SCORER_URL=http://scorer:8000
# Stored with every score, so a model rollout cannot mix incompatible matrix rows.
MATCH_SCORER_MODEL_VERSION=model-v3-best
# Date symmetric pair-score gate (score_AB + score_BA). Default 0.40.
MATCH_PAIR_THRESHOLD=0.40
# "1" uses cached semantic-interest scores for Mate; keep off while calibrating in shadow.
MATE_INTEREST_MATCHING=0
# Mate semantic-interest gate when enabled. Default 0.55.
MATE_MATCH_THRESHOLD=0.55
# how often the server looks for missing embeddings and missing or outdated pair scores
MATCH_SWEEP_INTERVAL_MS=600000
# "1" pairs any two searchers of the same mode within 50 km, for demos: no score, category,
# intent, age or gender gate, and a 30 s pair cooldown. Blocks, moderation and 18+ still hold.
MATCH_RELAXED=0
# a searcher whose last position is older than this is not matched, and their open offer
# ends without a pair cooldown (a backgrounded phone stops reporting but keeps its socket)
MATCH_STALE_FIX_MS=30000
INTEREST_MATCHER_URL=http://scorer:8001
DATABASE_URL=postgres://justmate:justmate@localhost:5432/justmate
# required in production; defaults to http://localhost:3000 elsewhere
BETTER_AUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# auth emails (magic links, password resets) over SMTP; required in production,
# without SMTP_HOST in development they are printed to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=JustMate <login@andrejzak.dev>
# optional, comma-separated extra auth origins, e.g. http://localhost:8081 for the web build
AUTH_TRUSTED_ORIGINS=
# Required to generate profile embeddings for ML matching. Onboarding questions, vibe lines,
# related interests, character, taste and selfie descriptions use fixed samples without it.
OPENAI_API_KEY=
# optional, defaults to gpt-4o-mini (needs vision and structured outputs)
OPENAI_MODEL=
# demo sockets (?demo=a|b): "true" or "false"; defaults to on outside production, off in it
DEMO_MODE=
# demo mode stage ends as "lat,lng", set after seeing the stage
STAGE_A=50.0680,19.9120
STAGE_B=50.0684,19.9135
