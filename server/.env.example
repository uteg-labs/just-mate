PORT=3000
MOCK_PORT=3001
# URL of the match_scorer HTTP container. Local compose: http://scorer:8000
# Local Python venv (no container): unset and the server falls back to spawning
# the NDJSON subprocess; see server/src/matching/scorer_http.ts.
MATCH_SCORER_URL=http://scorer:8000
# Symmetric pair-score gate (score_AB + score_BA). Default 0.40.
MATCH_PAIR_THRESHOLD=0.40
# URL of the interest_matcher HTTP container. Same compose service as the
# match_scorer, different port (default :8001). Used to compute soft_jaccard
# server-side from cached interest embeddings instead of doing it inline.
INTEREST_MATCHER_URL=http://scorer:8001
DATABASE_URL=postgres://justmate:justmate@localhost:5432/justmate
BETTER_AUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# auth emails (magic links, password resets) over SMTP; required in production,
# without SMTP_HOST in development they are printed to the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=JustMate <login@andrejzak.dev>
# optional, comma-separated extra auth origins, e.g. http://localhost:8081 for the web build
AUTH_TRUSTED_ORIGINS=
# optional; onboarding questions, vibe lines, related interests, character, taste and the selfie
# description fall back to fixed samples without it
OPENAI_API_KEY=
# optional, defaults to gpt-4o-mini (needs vision and structured outputs)
OPENAI_MODEL=
# demo mode stage ends as "lat,lng", set after seeing the stage
STAGE_A=50.0680,19.9120
STAGE_B=50.0684,19.9135
