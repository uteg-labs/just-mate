PORT=3000
MOCK_PORT=3001
DATABASE_URL=postgres://justmate:justmate@localhost:5432/justmate
BETTER_AUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# optional in development; auth emails (magic links, password resets) are printed to the server console when absent
RESEND_API_KEY=
AUTH_EMAIL_FROM=JustMate <auth@example.com>
# optional, comma-separated extra auth origins, e.g. http://localhost:8081 for the web build
AUTH_TRUSTED_ORIGINS=
# optional; onboarding questions, vibe lines and related interests fall back to fixed samples without it
ANTHROPIC_API_KEY=
# demo mode stage ends as "lat,lng", set after seeing the stage
STAGE_A=50.0680,19.9120
STAGE_B=50.0684,19.9135
