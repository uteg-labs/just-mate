{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/compass/**",
              "components/core/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/map/**",
              "components/surfaces/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, color, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:gray|glow|self|cold|hot|success|danger)$/]",
        "message": "<Badge> color must be one of 'gray' | 'glow' | 'self' | 'cold' | 'hot' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|dot)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'dot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Badge> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:bucket|align|style|key|ref|className|style|children)$/]",
        "message": "<BucketLabel> doesn't accept that prop. Declared props: bucket, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketLabel'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:cold|warm|hot|burning)$/]",
        "message": "<BucketLabel> bucket must be one of 'cold' | 'warm' | 'hot' | 'burning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<BucketLabel> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|leadingIcon|trailingIcon|fullWidth|loading|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, leadingIcon, trailingIcon, fullWidth, loading, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost|glow|danger|neutral)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost' | 'glow' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|padding|radius|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, level, padding, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<CheckRow> doesn't accept that prop. Declared props: label, description, checked, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|icon|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, icon, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Chip> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompassDial'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotation|bucket|size|waiting|style|key|ref|className|style|children)$/]",
        "message": "<CompassDial> doesn't accept that prop. Declared props: rotation, bucket, size, waiting, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompassDial'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:cold|warm|hot|burning)$/]",
        "message": "<CompassDial> bucket must be one of 'cold' | 'warm' | 'hot' | 'burning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:seconds|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: seconds, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|title)$/]",
        "message": "<Countdown> size must be one of 'display' | 'title'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|iconSize|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, iconSize, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:material|tint|ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'material' | 'tint' | 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|intent|quote|state|secondsLeft|onAccept|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<MatchCard> doesn't accept that prop. Declared props: percent, intent, quote, state, secondsLeft, onAccept, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:offered|waiting|expired)$/]",
        "message": "<MatchCard> state must be one of 'offered' | 'waiting' | 'expired'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: initials, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: items, value, onChange, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|grabber|padding|material|style|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: children, grabber, padding, material, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|intent|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, intent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:invisible|searching|offline)$/]",
        "message": "<StatusPill> status must be one of 'invisible' | 'searching' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<StepDots> doesn't accept that prop. Declared props: count, active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onToggle|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, checked, onToggle, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VibeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|intent|eyebrow|compact|children|style|key|ref|className|style|children)$/]",
        "message": "<VibeCard> doesn't accept that prop. Declared props: quote, intent, eyebrow, compact, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ZoneGlow'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|size|visible|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ZoneGlow> doesn't accept that prop. Declared props: n, size, visible, onClick, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
