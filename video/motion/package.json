{
  "name": "@justmate/motion",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "preview:build": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs && npx serve out/preview",
    "render": "for c in Main Tomek Lucia Ania Marta Piotr; do remotion render $c out/just-mate-$(echo $c | tr A-Z a-z).mp4; done",
    "render:main": "remotion render Main out/just-mate-main.mp4",
    "still": "remotion still",
    "vo": "python3 scripts/vo.py",
    "vo:measure": "python3 scripts/vo.py --measure",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "^4.0.532",
    "@remotion/player": "^4.0.532",
    "@remotion/shapes": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.0",
    "world-atlas": "^2.0.2"
  }
}
